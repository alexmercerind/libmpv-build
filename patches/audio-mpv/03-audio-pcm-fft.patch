+enum {
+    AUDIO_PLOT_PCM_MAX = 2048,  // mono samples per audio-pcm update
+    AUDIO_PLOT_FFT_LEN = 1024,  // analysis window at audio-fft-rate
+    AUDIO_PLOT_FFT_BINS = AUDIO_PLOT_FFT_LEN / 2 + 1,
