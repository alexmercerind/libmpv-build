+// True if any client currently observes the given property (or a sub-path of
+// it). The audio-pcm/audio-fft tap uses it to stay idle unless somebody
+// listens, so mpv_unobserve_property doubles as the unsubscribe path.
+bool mp_is_property_observed(struct MPContext *mpctx, const char *name)
+{
+    struct mp_client_api *clients = mpctx->clients;
+    int id = mp_get_property_id(mpctx, name);
+    if (id < 0)
+        return false;
+    bool res = false;
+    mp_mutex_lock(&clients->lock);
+    for (int n = 0; n < clients->num_clients && !res; n++) {
+        struct mpv_handle *client = clients->clients[n];
+        mp_mutex_lock(&client->lock);
+        for (int i = 0; i < client->num_properties; i++) {
+            if (client->properties[i]->id == id &&
+                property_shared_prefix(name, client->properties[i]->name))
+            {
+                res = true;
+                break;
+            }
+        }
+        mp_mutex_unlock(&client->lock);
+    }
+    mp_mutex_unlock(&clients->lock);
+    return res;
+}
